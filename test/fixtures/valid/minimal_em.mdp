; Canonical valid GROMACS MDP fixture.
; Source: derived from test/fixtures/rules/valid_mdp_parameters.mdp and
;         https://manual.gromacs.org/current/user-guide/mdp-options.html
; Expectation: analyze_file produces no diagnostics.
integrator  = md
nsteps      = 50000
dt          = 0.002
coulombtype = PME
rcoulomb    = 1.0
rvdw        = 1.0
constraints = all-bonds
