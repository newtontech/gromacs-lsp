; Minimal valid GROMACS topology: every [ molecules ] entry has a matching
; [ moleculetype ] definition, and the file defines [ moleculetype ] + [ atoms ]
; sections so the analyzer does not flag a fragment.
[ defaults ]
1                       2 yes 0.5 0.5

[ atomtypes ]
opls_001   H     6      1.00800     0.000       A   0.024       2.0
opls_002   C     6      12.01100    0.000       A   0.060       3.5

[ moleculetype ]
Protein             3

[ atoms ]
1       opls_002   1       Protein      C1       1       0        12.011    0
2       opls_002   2       Protein      C2       2       0        12.011    0

[ moleculetype ]
SOL                 2

[ atoms ]
1       opls_001   1       SOL      OW       1       0        15.999    0

[ system ]
test system

[ molecules ]
Protein             1
SOL                 3
