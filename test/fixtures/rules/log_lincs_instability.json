{
  "rule_id": "gromacs.log.lincs_instability",
  "description": "Errors when a GROMACS runtime log contains a LINCS instability warning.",
  "severity": "error",
  "source": "official",
  "manual_ref": "https://manual.gromacs.org/current/user-guide/run-time-errors.html",
  "diagnostics": [
    {
      "rule_id": "gromacs.log.lincs_instability",
      "code": "GMX402",
      "severity": "error",
      "category": "preflight/runtime-risk",
      "message": "LINCS instability detected: Step 100, time 0.2 (ps)  LINCS warning",
      "range": {
        "start": {"line": 6, "character": 0},
        "end": {"line": 6, "character": 1}
      },
      "fix_hints": [
        {"kind": "check_lincs", "hint": "reduce_timestep_or_check_constraints"}
      ]
    },
    {
      "rule_id": "gromacs.log.lincs_instability",
      "code": "GMX402",
      "severity": "error",
      "category": "preflight/runtime-risk",
      "message": "LINCS instability detected: Step 200, time 0.4 (ps)  LINCS warning",
      "range": {
        "start": {"line": 11, "character": 0},
        "end": {"line": 11, "character": 1}
      },
      "fix_hints": [
        {"kind": "check_lincs", "hint": "reduce_timestep_or_check_constraints"}
      ]
    }
  ]
}
